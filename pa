#!/bin/sh
set -eu

launcher_path=$0
while [ -L "$launcher_path" ]; do
    launcher_target=$(readlink "$launcher_path")
    case "$launcher_target" in
        /*) launcher_path=$launcher_target ;;
        *) launcher_path=$(dirname -- "$launcher_path")/$launcher_target ;;
    esac
done
repo_dir=$(CDPATH= cd -- "$(dirname -- "$launcher_path")" && pwd)

# Keep the current native library physically separate from the frozen model
# authority.  Dispatch before model interpreter selection, seal verification,
# and ML environment setup so `pa native` never imports or maps the model.
case "${1-}" in
    native)
        shift
        native_root=${PEANO_NATIVE_LAB_ROOT:-"$repo_dir/../vietnam2026-arithmetic"}
        if [ ! -d "$native_root" ]; then
            echo "pa: native Peano Lab root not found: $native_root" >&2
            echo "pa: set PEANO_NATIVE_LAB_ROOT to the current arithmetic worktree" >&2
            exit 2
        fi
        native_root=$(CDPATH= cd -- "$native_root" && pwd)
        native_runner="$native_root/scripts/peano_native_shell.py"
        if [ ! -f "$native_runner" ]; then
            echo "pa: native Peano Lab runner not found: $native_runner" >&2
            exit 2
        fi
        if ! command -v python3 >/dev/null 2>&1; then
            echo "pa: Python 3.10 or newer is required for native mode" >&2
            exit 2
        fi
        if ! python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'; then
            echo "pa: Python 3.10 or newer is required for native mode" >&2
            exit 2
        fi
        exec python3 "$native_runner" "$@"
        ;;
    model)
        shift
        ;;
esac

adapter_dir="$repo_dir/results/peano-policy/diagnostics/qwen3-1.7b-lora-v3-morning-diagnostic-20260731-r1"
cache_dir="$repo_dir/.cache/huggingface/hub"

# This reviewed launcher is deliberately bound to the frozen morning
# diagnostic.  The generic Python entry point still requires an explicit
# --diagnostic flag and may be used with another adapter directly.
help_requested=false
for argument in "$@"; do
    case "$argument" in
        --adapter|--adapter=*|--cache-dir|--cache-dir=*)
            echo "pa: this launcher is fixed to the morning diagnostic adapter and cache" >&2
            exit 2
            ;;
        -h|--help) help_requested=true ;;
    esac
done

if [ "$help_requested" = true ]; then
    printf '%s\n' \
        'Unified Peano launcher modes:' \
        '  pa native    current model-free theorem library' \
        '  pa model     frozen diagnostic proof-policy shell' \
        '  pa           backward-compatible alias for pa model' \
        ''
fi

if [ -x "$repo_dir/.venv/peano-model-macos/bin/python" ]; then
    peano_python="$repo_dir/.venv/peano-model-macos/bin/python"
elif [ "$help_requested" = true ]; then
    # Keep help model-free for a fresh checkout.  No proof attempt may use the
    # unsealed system interpreter.
    peano_python=python3
else
    echo "pa: run scripts/bootstrap_peano_model_lab_macos.sh first" >&2
    exit 2
fi

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ENABLE_MPS_FALLBACK=1

if [ "$help_requested" = false ]; then
    echo "[startup 1/3] Verifying frozen 3.44 GB base-model seal…" >&2
    "$peano_python" "$repo_dir/scripts/prefetch_peano_base_model.py" \
        --verify-only >/dev/null
    echo "[startup 2/3] Verifying frozen 158 MB adapter seal…" >&2
    "$peano_python" "$repo_dir/scripts/verify_peano_morning_adapter.py" \
        "$adapter_dir" >/dev/null
fi

exec "$peano_python" "$repo_dir/scripts/peano_model_lab.py" \
    --diagnostic \
    --adapter "$adapter_dir" \
    --cache-dir "$cache_dir" \
    --local-files-only \
    "$@"
