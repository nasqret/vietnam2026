name\n    if \"bytes\" in pin: assert size==pin[\"bytes\"],name\n    checked.append(dict(path=name,bytes=size,sha256=digest.hexdigest()))\ndocs=[root/\"PLAN/28_recursive_polynomial_gcd_bezout.md\",base/\"README.md\",root/\"research/arithmetic-library/working/prime-field-gcd-existence-v1/README.md\"]\nlinks=[]\nfor path in docs:\n    text=path.read_text()\n    assert all(line==line.rstrip(\" \\t\") for line in text.splitlines()),path\n    for target in re.findall(r\"\\[[^\\]]*\\]\\(([^)]+)\\)\",text):\n        if \"://\" in target or target.startswith(\"#\"): continue\n        destination=(path.parent/target.split(\"#\",1)[0]).resolve()\n        assert destination.exists(),(path,target)\n        links.append(dict(source=str(path.relative_to(root)),target=target))\nfor entry in execution[\"records\"]:\n    assert entry[\"exit_code\"]==0\n    assert \"\".join(part[\"output\"] for part in entry[\"parts\"])==entry[\"stdout\"]\n    assert json.loads(entry[\"stdout\"].strip().splitlines()[-1])==entry[\"report\"]\n    assert entry[\"report\"][\"source_binding\"]==audit[\"source_binding\"]\nassert not summary[\"publication\"][\"alpha_admission_performed\"]\nassert not summary[\"publication\"][\"commit_performed\"]\nassert not summary[\"theorem_scope\"][\"full_G091_prime_power_field_construction_proved\"]\npayload=(base/\"completion-accounting-v1.json\").read_bytes()\nprint(json.dumps(dict(kind=\"completion-documentation-and-pin-sanity\",pins_checked=len(checked),checked_pins=checked,local_links_checked=len(links),links=links,actual_final_records_reconciled=16,complete_accounting_bytes=len(payload),complete_accounting_sha256=hashlib.sha256(payload).hexdigest(),source_binding=audit[\"source_binding\"],proof_calls=0,seconds=time.monotonic()-started,peak_rss_bytes=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss),sort_keys=True))\n'",
