      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 1,
      "name": "crt_pairwise_compatible_dominating_last_solution",
      "proof_bundle_node_id": 299,
      "scope": "candidate",
      "stable_member": false,
      "summary": "Whenever the last modulus is an actual common multiple of all predecessors, exact pairwise gcd compatibility makes the last residue itself a simultaneous solution, including zero and non-coprime moduli."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v27",
      "alpha_first_enrolled_version": "v25",
      "href": "tag/GC0018.html?v=481a9a378e54",
