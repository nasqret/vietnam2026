      "id": "DT0001",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 0,
      "name": "dirichlet_convolution_entry_first_input_transport",
      "proof_bundle_node_id": 208,
      "scope": "candidate",
      "stable_member": false,
      "summary": "Transport only the first actual lookup at a preserved index; retain the witnessed quotient, second lookup and signed product, including omitted zero entries."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0002.html?v=6c9ebfb3c37e",
      "id": "DT0002",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 1,
      "name": "dirichlet_convolution_prefix_first_input_transport",
      "proof_bundle_node_id": 209,
      "scope": "candidate",
      "stable_member": false,
      "summary": "The same actual summand table survives a first-input change strictly above its inclusive prefix bound; no equality at the changed endpoint is assumed."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0003.html?v=6c9ebfb3c37e",
      "id": "DT0003",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 2,
      "name": "dirichlet_convolution_first_input_append_preserves",
      "proof_bundle_node_id": 210,
      "scope": "candidate",
      "stable_member": false,
      "summary": "Appending a first-input entry at l preserves every previously constructed convolution at m<l, with its original actual fold witnesses."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0004.html?v=6c9ebfb3c37e",
      "id": "DT0004",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 3,
      "name": "dirichlet_convolution_table_first_input_append_preserves",
      "proof_bundle_node_id": 211,
      "scope": "candidate",
      "stable_member": false,
      "summary": "The whole earlier positive output table remains valid after appending the first input, including the vacuous N=0 boundary and arbitrary zero entries."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0005.html?v=6c9ebfb3c37e",
      "id": "DT0005",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 0,
      "name": "dirichlet_convolution_last_entry_iff",
      "proof_bundle_node_id": 212,
      "scope": "candidate",
      "stable_member": false,
      "summary": "For n>0 the final divisor entry is exactly F(n)*G(1), using the actual quotient witness n=n*1 in both directions."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0006.html?v=6c9ebfb3c37e",
      "id": "DT0006",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 0,
      "name": "dirichlet_convolution_strict_prefix_exists",
      "proof_bundle_node_id": 213,
      "scope": "candidate",
      "stable_member": false,
      "summary": "Actually construct the remainder prefix through k and its S k-entry fold even when the first input is only an inclusive k-table; the arbitrary value at S k is excluded."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0007.html?v=6c9ebfb3c37e",
      "id": "DT0007",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 1,
      "name": "dirichlet_convolution_prefix_last_step",
      "proof_bundle_node_id": 214,
      "scope": "candidate",
      "stable_member": false,
      "summary": "Append the actual endpoint product to the real strict-prefix fold, constructing the full S(S k)-entry convolution without an assumed recurrence."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0008.html?v=6c9ebfb3c37e",
      "id": "DT0008",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 2,
      "name": "dirichlet_convolution_first_input_append_step",
      "proof_bundle_node_id": 215,
      "scope": "candidate",
      "stable_member": false,
      "summary": "Change G(S k) only after computing the strict remainder, preserve every earlier summand, and construct the new convolution from the independently proved signed linear equation."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT0009.html?v=6c9ebfb3c37e",
      "id": "DT0009",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 0,
      "name": "dirichlet_convolution_zero_prefix_sum",
      "proof_bundle_node_id": 216,
      "scope": "candidate",
      "stable_member": false,
      "summary": "The genuine one-entry fold of an inclusive zero summand prefix is canonical zero, without restricting either input value at zero."
    },
    {
      "alpha_checked_use": true,
      "alpha_edition_version": "v34",
      "alpha_first_enrolled_version": "v31",
      "href": "tag/DT000A.html?v=6c9ebfb3c37e",
      "id": "DT000A",
      "independent_lean_bundle_verified": true,
      "kind": "theorem",
      "layer": 2,
      "name": "dirichlet_convolution_at_one_iff",
      "proof_bundle_node_id": 217,
      "scope": "candidate",
      "stable_member": false,
      "summary": "Actual convolution at input one is exactly the actual signed product F(1)*G(1); both implications construct or inspect the real two-entry masked fold."
    },
