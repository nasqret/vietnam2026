      "id": "ND0143",
      "kind": "definition",
      "layer": 1,
      "name": "SignedBalance",
      "signature": "SignedBalance(z,p,n)",
      "summary": "The original canonical code z represents the integer difference p−n; these supplied components need not be normalized."
    },
    {
      "global_definition": null,
      "href": "definition/ND0251.html?v=6c9ebfb3c37e",
      "id": "ND0251",
      "kind": "definition",
      "layer": 2,
      "name": "ArithTable",
      "signature": "ArithTable(N,F)",
      "summary": "An actual packed signed table with canonical signed entries through index N, including index zero. It contains no divisor transform or inversion hypothesis."
    },
    {
      "global_definition": null,
      "href": "definition/ND0252.html?v=6c9ebfb3c37e",
      "id": "ND0252",
      "kind": "definition",
      "layer": 2,
      "name": "ArithAt",
