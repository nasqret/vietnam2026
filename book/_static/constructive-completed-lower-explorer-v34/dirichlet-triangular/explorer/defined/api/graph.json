      "id": "ND0254",
      "kind": "definition",
      "layer": 3,
      "name": "ArithTableEqual",
      "signature": "ArithTableEqual(F,G,l)",
      "summary": "Pointwise equality of actual canonical signed lookups below l, not equality of table codes or their positive/negative components."
    },
