# Ensure HTTPS behind the faculty TLS-terminating reverse proxy.
# Loop-safe: only redirects when the proxy reports the original scheme was http
# (X-Forwarded-Proto). If the header is absent or https, this rule does nothing.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Directory requests resolve to their index.html before this file match runs.
# Never retain old explorer pages; revalidate shared assets without disabling
# conditional ETag/Last-Modified requests or affecting unrelated faculty pages.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|json)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
