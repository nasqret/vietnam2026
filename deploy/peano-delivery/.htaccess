# Owner-authorized, read-only Peano delivery adapter (2026-09-05).
# Install only in /peano-lab-next/ or /peano-lab/, after its payload.
# Keep the ordinary static configuration in peano-lab/.htaccess as rollback.
DirectoryIndex index.html

<IfModule mod_env.c>
  # The adapter negotiates already-compressed, verified gzip representations.
  # Do not apply a second compression filter, including to ZIP or WOFF2.
  SetEnv no-gzip 1
  SetEnv no-brotli 1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteRule ^peano-delivery\.php$ - [END]
  RewriteRule ^ peano-delivery.php [END]
</IfModule>
