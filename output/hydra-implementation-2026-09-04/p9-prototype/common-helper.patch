+def _native_exec_audit(backend):
+    from adviser_process import ENVIRONMENT, native_argv
+    expected = native_argv(backend)
+    available = [True]
+
+    def audit(event, args):
+        if event == "os.exec":
+            executable, argv, environment = args
+            if (not available[0] or executable != expected[0] or type(argv) not in (list, tuple)
+                    or list(argv) != expected or environment != ENVIRONMENT):
+                raise PermissionError("Only one exact pinned native exec is authorized.")
+            available[0] = False
+            return
+        _audit(event, args)
+
+    return audit
+
