+def native_package(*, verify_files=False, should_stop=None):
+    _require(NATIVE_DIRECTORY.is_dir() and not NATIVE_DIRECTORY.is_symlink(), "The pinned P9 native package is absent.")
+    path = NATIVE_DIRECTORY / "manifest.json"
+    expected = {"bytes": NATIVE_MANIFEST_BYTES, "sha256": NATIVE_MANIFEST_SHA256}
+    _require(_file_pin(path, 65536) == expected, "The native package manifest changed.")
+    raw = path.read_bytes()
+    _require(len(raw) == expected["bytes"] and hashlib.sha256(raw).hexdigest() == expected["sha256"],
+             "The pinned native manifest changed while read.")
+    manifest = json.loads(raw)
+    _require(manifest.get("schema") == "hydra-p9-native-package-v1" and manifest.get("platform") == "darwin-arm64"
+             and manifest.get("status") == "built-not-executed" and len(manifest["files"]) <= 256
+             and manifest["expanded_bytes"] <= 32 * 1024**2, "Invalid native package inventory.")
+    for backend, filename in NATIVE_EXECUTABLES.items():
+        _require(manifest["executables"][backend]["path"] == filename
+                 and manifest["backends"][backend]["version"] == VERSIONS[backend], "Unexpected native executable binding.")
+    _require(tuple(manifest["backends"]["e"]["args"]) == E_ARGUMENTS, "Unexpected E argument profile.")
+    if verify_files:
+        actual = set()
+        for directory, folders, names in os.walk(NATIVE_DIRECTORY, followlinks=False):
+            for folder in folders:
+                _require(not (Path(directory) / folder).is_symlink(), "Symlink in native package.")
+            for name in names:
+                relative = (Path(directory) / name).relative_to(NATIVE_DIRECTORY).as_posix()
+                if relative != "manifest.json":
+                    actual.add(relative)
+                    _require(len(actual) <= len(manifest["files"]), "Unexpected native package file.")
+        _require(actual == set(manifest["files"]), "Native package file inventory changed.")
+        total = 0
+        for name, descriptor in manifest["files"].items():
+            if should_stop is not None and should_stop():
+                raise TimeoutError("Native package verification reached cancellation or deadline.")
+            _require(_file_pin(NATIVE_DIRECTORY / name, 16 * 1024**2) == descriptor, "Pinned native package content changed.")
+            total += descriptor["bytes"]
+        _require(total == manifest["expanded_bytes"], "Native package byte accounting changed.")
+    return manifest
+
