+class _ProcTaskInfo(ctypes.Structure):
+    # Apple's sys/proc_info.h: six uint64_t fields then twelve int32_t fields.
+    # Only the documented resident-size field is used. No process arguments,
+    # environment, files, or other private content are queried.
+    _fields_ = [("virtual_size", ctypes.c_uint64), ("resident_size", ctypes.c_uint64),
+                ("times", ctypes.c_uint64 * 4), ("counters", ctypes.c_int32 * 12)]
+
+
+@lru_cache(maxsize=1)
+def _proc_pidinfo():
+    if sys.platform != "darwin" or ctypes.sizeof(_ProcTaskInfo) != 96 or _ProcTaskInfo.resident_size.offset != 8:
+        raise OSError("The fixed macOS RSS accounting interface is unavailable.")
+    library = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
+    query = library.proc_pidinfo
+    query.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
+    query.restype = ctypes.c_int
+    return query
+
+
+def _resident_size(pid):
+    """A fixed read-only API, used for self-probe and an owned child only."""
+    require(type(pid) is int and 0 < pid < 2**31, "Invalid owned-process identity.")
+    info = _ProcTaskInfo()
+    ctypes.set_errno(0)
+    received = _proc_pidinfo()(pid, 4, 0, ctypes.byref(info), ctypes.sizeof(info))
+    if received != ctypes.sizeof(info) or info.resident_size == 0:
+        raise OSError(ctypes.get_errno(), "Incomplete macOS owned-process RSS accounting.")
+    return int(info.resident_size)
+
+
+def _owned_child_rss(process):
+    # An unreaped direct child cannot have its PID recycled. No other code
+    # owns this Popen object; after reaping, do not query or signal the PID.
+    if process.poll() is not None:
+        return None
+    try:
+        return _resident_size(process.pid)
+    except (OSError, ValueError):
+        if process.poll() is not None:
+            return None  # Normal completion can race an accounting query.
+        raise
 
 
