        "declared_publication_dependencies",
        "minimality_claim",
        "optimized_dependencies",
        "optimized_leave_one_out_receipt_sha256",
        "publication_union",
        "readable_dependencies",
        "readable_leave_one_out_receipt_sha256",
        "status"
      ]
    },
    "documentation": {
      "receipt_required": [
        "artifact_path",
