        "replay_status"
      ]
    },
    "readable_proof": {
      "required": [
        "script",
        "script_sha256"
      ]
    },
    "required": [
      "declaration_order",
      "definitions",
      "dependencies",
      "documentation",
      "explanation",
      "index",
      "layer",
      "lineage",
      "logic",
      "name",
      "optimized_construction",
      "proof",
      "readable_proof",
      "source",
      "statement"
    ],
    "source": {
