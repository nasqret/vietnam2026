        "canonical_sha256",
        "formula_sha256",
        "source",
        "source_sha256"
      ]
    }
  },
  "unresolved_constants": {
    "dependency_status": "declared-publication-only",
    "explanation_review_status": "pending-human-review",
    "lineage_status": "pending",
    "optimized_claim": "submitted-not-best-known"
  },
  "v": 1
}
